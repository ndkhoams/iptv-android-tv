<resources>
    <!-- Base TV application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/tv_bg_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Dialog theme for TV remote navigation -->
    <style name="TvDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@color/tv_panel_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
