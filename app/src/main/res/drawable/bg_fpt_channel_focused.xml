<?xml version="1.0" encoding="utf-8"?>
<!-- Hàng kênh chuẩn live_item_channel.xml trên FPT Play Box G2: Nền trắng sáng + Vạch đứng cam FPT mép phải -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền trắng sáng #F1F3F5 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F1F3F5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Vạch đứng Cam FPT #FF6500 dày 7dp ở mép phải -->
    <item android:gravity="end">
        <shape android:shape="rectangle">
            <size android:width="7dp" />
            <solid android:color="#FF6500" />
            <corners
                android:topRightRadius="8dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
