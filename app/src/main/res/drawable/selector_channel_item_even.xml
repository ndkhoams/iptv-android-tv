<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_fpt_channel_focused" />
    <item android:state_selected="true" android:drawable="@drawable/bg_fpt_channel_selected" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181818" />
            <stroke android:width="1dp" android:color="#181818" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>

