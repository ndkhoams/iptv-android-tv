<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="450dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_item_normal"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvActionChannelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="VTV1 HD"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnToggleFavorite"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/selector_button_tv"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="★ Thêm vào Kênh Yêu Thích"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnSetDefaultStartup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/selector_button_tv"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="16dp"
        android:text="📺 Đặt làm Kênh Mặc Định khi Khởi Động"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnCancelAction"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/selector_button_tv"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="Đóng"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
