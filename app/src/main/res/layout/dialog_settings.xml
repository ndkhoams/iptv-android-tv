<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fpt_bg_dark"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Tiêu đề Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV"
            android:textColor="@color/fpt_orange"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="Play"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="• CÀI ĐẶT HỆ THỐNG &amp; NGUỒN PHÁT"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Thân Dialog: Cột Trái (Cài Đặt Toàn Bộ) & Cột Phải (Thao Tác Nhanh) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- CỘT TRÁI: TOÀN BỘ CÀI ĐẶT (Cuộn ScrollView mượt mà trên TV, chiếm 72% chiều rộng) -->
        <ScrollView
            android:id="@+id/scrollViewSettingsLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.6"
            android:background="@drawable/bg_fpt_glass_panel"
            android:padding="14dp"
            android:layout_marginEnd="10dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. DANH SÁCH M3U -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Danh Sách M3U Đang Có:"
                    android:textColor="@color/fpt_orange"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Nhấn OK: Chọn • Sang Phải (hoặc Giữ OK): Xóa danh sách"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <!-- Danh sách các nguồn M3U -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlaylists"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:background="#181818"
                    android:padding="6dp"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusDown="@+id/etNewPlaylistName"
                    android:nextFocusRight="@+id/btnCloseSettings" />

                <!-- Form thêm nguồn M3U mới -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#181818"
                    android:padding="10dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thêm nguồn M3U mới:"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etNewPlaylistName"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:background="#141414"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:hint="Tên danh sách (Ví dụ: FPT IPTV, Thể Thao...)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:nextFocusUp="@+id/rvPlaylists"
                        android:nextFocusDown="@+id/etNewPlaylistUrl"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <EditText
                        android:id="@+id/etNewPlaylistUrl"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:background="#141414"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:hint="Đường link URL hoặc đường dẫn file local"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="12sp"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:nextFocusUp="@+id/etNewPlaylistName"
                        android:nextFocusDown="@+id/btnBrowseLocalFile"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnBrowseLocalFile"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="📂 Chọn File Local/USB"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/selector_button_tv"
                            android:nextFocusUp="@+id/etNewPlaylistUrl"
                            android:nextFocusRight="@+id/btnAddPlaylist"
                            android:nextFocusDown="@+id/etUdpxyServer"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <Button
                            android:id="@+id/btnAddPlaylist"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="+ Thêm Danh Sách"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/selector_button_tv"
                            android:nextFocusUp="@+id/etNewPlaylistUrl"
                            android:nextFocusLeft="@+id/btnBrowseLocalFile"
                            android:nextFocusRight="@+id/btnCloseSettings"
                            android:nextFocusDown="@+id/etUdpxyServer"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. MÁY CHỦ UDPXY SERVER -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="2. Máy Chủ udpxy (Chuyển luồng UDP/RTP):"
                    android:textColor="@color/fpt_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutUdpxySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#181818"
                    android:padding="8dp"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/etUdpxyServer"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="#141414"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:hint="IP:Port (Ví dụ: 192.168.1.1:4022 hoặc 10.0.0.222:4022)"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="12sp"
                        android:inputType="text"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:nextFocusUp="@+id/btnAddPlaylist"
                        android:nextFocusDown="@+id/rbPlayerVlc"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tự động chuyển tiếp các kênh UDP/RTP qua server udpxy mà không cần can thiệp vào link."
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 3. BỘ GIẢI MÃ VIDEO (KHỬ RĂNG CƯA 1080i) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="3. Bộ Giải Mã Video &amp; Khử Xé Hình (Deinterlace):"
                    android:textColor="@color/fpt_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgPlayerEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#181818"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/rbPlayerVlc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="LibVLC (Phần cứng MediaCodec - Mượt mà 60fps, Không xanh màn)"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:nextFocusUp="@+id/etUdpxyServer"
                        android:nextFocusDown="@+id/rbPlayerExo"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <RadioButton
                        android:id="@+id/rbPlayerExo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ExoPlayer (Google MediaCodec - Nhẹ máy chuẩn Android TV)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/rbPlayerVlc"
                        android:nextFocusDown="@+id/rbDeinterlaceYadif"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Thuật toán khử răng cưa / xé hình 1080i (VLC):"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgDeinterlaceMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#181818"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/rbDeinterlaceYadif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Yadif (Khuyên dùng - Nét như PC, không mờ, không bóng ma)"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:nextFocusUp="@+id/rbPlayerExo"
                        android:nextFocusDown="@+id/rbDeinterlaceLinear"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <RadioButton
                        android:id="@+id/rbDeinterlaceLinear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Linear (Nội suy mượt mà, triệt tiêu xé hình, siêu nhẹ)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/rbDeinterlaceYadif"
                        android:nextFocusDown="@+id/rbDeinterlaceBlend"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <RadioButton
                        android:id="@+id/rbDeinterlaceBlend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Blend (Gộp 2 trường quét - Mức độ cơ bản)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/rbDeinterlaceLinear"
                        android:nextFocusDown="@+id/rbDeinterlaceOff"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <RadioButton
                        android:id="@+id/rbDeinterlaceOff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tắt Deinterlace (Giữ nguyên luồng gốc)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/rbDeinterlaceBlend"
                        android:nextFocusDown="@+id/rbFirstChannel"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />
                </RadioGroup>

                <!-- 4. CÀI ĐẶT KHỞI ĐỘNG CÙNG TV -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="4. Cài Đặt Khởi Động &amp; Mở Kênh Tự Động:"
                    android:textColor="@color/fpt_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#181818"
                    android:padding="8dp"
                    android:layout_marginTop="6dp">

                    <RadioGroup
                        android:id="@+id/rgStartupMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/rbFirstChannel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mở kênh đầu tiên của danh sách (Mặc định)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:nextFocusUp="@+id/rbDeinterlaceOff"
                            android:nextFocusDown="@+id/rbLastWatched"
                            android:nextFocusRight="@+id/btnCloseSettings"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <RadioButton
                            android:id="@+id/rbLastWatched"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Vào lại kênh vừa xem gần nhất"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:nextFocusUp="@+id/rbFirstChannel"
                            android:nextFocusDown="@+id/rbFixedChannel"
                            android:nextFocusRight="@+id/btnCloseSettings"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <RadioButton
                            android:id="@+id/rbFixedChannel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Luôn mở một kênh cố định:"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:nextFocusUp="@+id/rbLastWatched"
                            android:nextFocusDown="@+id/btnBackupConfig"
                            android:nextFocusRight="@+id/btnCloseSettings"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvCurrentFixedChannel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="2dp"
                        android:text="Chưa thiết lập (Bấm giữ OK trên kênh bất kỳ để đặt làm mặc định)"
                        android:textColor="@color/fpt_orange"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 5. SAO LƯU & KHÔI PHỤC CẤU HÌNH -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="5. Sao Lưu &amp; Khôi Phục Cấu Hình:"
                    android:textColor="@color/fpt_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#181818"
                    android:padding="8dp"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnBackupConfig"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="💾  SAO LƯU"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/selector_button_tv"
                            android:nextFocusUp="@+id/rbFixedChannel"
                            android:nextFocusRight="@+id/btnRestoreConfig"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />

                        <Button
                            android:id="@+id/btnRestoreConfig"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="📥  KHÔI PHỤC"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/selector_button_tv"
                            android:nextFocusUp="@+id/rbFixedChannel"
                            android:nextFocusLeft="@+id/btnBackupConfig"
                            android:nextFocusRight="@+id/btnCloseSettings"
                            android:focusable="true"
                            android:focusableInTouchMode="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBackupStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Lưu toàn bộ danh sách M3U, yêu thích, udpxy và thiết lập vào file tvplay_backup.json."
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- CỘT PHẢI: BẢNG THAO TÁC NHANH (Nút Áp Dụng, Đóng & Hướng Dẫn Điều Khiển TV) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:background="@drawable/bg_fpt_glass_panel"
            android:padding="16dp"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THAO TÁC NHANH"
                android:textColor="@color/fpt_orange"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Nút Áp Dụng & Đóng (Nổi bật, dễ truy cập mọi lúc) -->
            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✓  ÁP DỤNG &amp; ĐÓNG"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/selector_button_tv"
                android:nextFocusLeft="@+id/scrollViewSettingsLeft"
                android:nextFocusDown="@+id/btnCancelSettings"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Nút Hủy / Đóng -->
            <Button
                android:id="@+id/btnCancelSettings"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:text="✕  HỦY / ĐÓNG"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/selector_btn_delete_tv"
                android:nextFocusUp="@+id/btnCloseSettings"
                android:nextFocusLeft="@+id/scrollViewSettingsLeft"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Hộp mẹo điều khiển TV Remote -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="#181818"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 MẸO ĐIỀU KHIỂN TV:"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Nhấn phím Phải (▶) từ bất kỳ mục cài đặt nào để chuyển nhanh sang nút Áp Dụng.\n\n• Nhấn phím Trái (◀) để quay lại danh sách cài đặt.\n\n• Bấm phím MENU hoặc BACK để lưu và đóng nhanh."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Thông tin phiên bản & Web Remote -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TV Play v2.0.1 (Android TV)"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="Web Remote: port 8080"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
