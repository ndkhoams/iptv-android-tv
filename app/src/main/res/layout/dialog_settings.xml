<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_normal"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tiêu đề Dialog -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cài Đặt Ứng Dụng &amp; Danh Sách M3U"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- PHẦN 1: CÁC DANH SÁCH M3U ĐÃ THÊM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Danh Sách M3U (Chọn danh sách để xem):"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylists"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#0F172A"
            android:padding="6dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Form thêm danh sách M3U mới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#131D2E"
            android:padding="10dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thêm nguồn M3U mới:"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="#0A0E17"
                android:paddingHorizontal="10dp"
                android:hint="Tên danh sách (Ví dụ: Thể Thao, Kênh Nhà Mạng...)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <EditText
                android:id="@+id/etNewPlaylistUrl"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="#0A0E17"
                android:paddingHorizontal="10dp"
                android:hint="Đường link URL (http://... hoặc https://...)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:inputType="textUri"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <Button
                android:id="@+id/btnAddPlaylist"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="18dp"
                android:text="+ Thêm Danh Sách"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/selector_button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginVertical="16dp" />

        <!-- PHẦN 2: CÀI ĐẶT KHỞI ĐỘNG CÙNG TV -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Cài Đặt Khởi Động &amp; Mở Kênh Tự Động:"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Checkbox tự mở khi bật TV -->
        <CheckBox
            android:id="@+id/cbAutoStartOnBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tự động mở ứng dụng ngay khi Android TV khởi động"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="12dp" />

        <!-- Lựa chọn kênh mở khi khởi động -->
        <RadioGroup
            android:id="@+id/rgStartupMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbLastWatched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vào lại kênh vừa xem gần nhất"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <RadioButton
                android:id="@+id/rbFixedChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Luôn mở một kênh cố định:"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvCurrentFixedChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="2dp"
            android:text="Chưa thiết lập (Bấm giữ OK trên kênh bất kỳ để đặt làm mặc định)"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <!-- Nút Đóng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:text="Đóng &amp; Áp Dụng"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/selector_button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
