<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fpt_bg_dark"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Tiêu đề Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV"
            android:textColor="@color/fpt_orange"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="Play"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="• CÀI ĐẶT HỆ THỐNG &amp; NGUỒN PHÁT"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Thân Dialog: 2 Cột chuẩn Android TV Full Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- CỘT TRÁI: QUẢN LÝ DANH SÁCH M3U -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_fpt_glass_panel"
            android:padding="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Danh Sách M3U Đang Có:"
                android:textColor="@color/fpt_orange"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Nhấn OK: Chọn • Sang Phải (hoặc Giữ OK): Xóa danh sách"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <!-- Danh sách các nguồn M3U -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylists"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1A1A1A"
                android:padding="6dp"
                android:clipToPadding="false"
                android:focusable="false"
                android:descendantFocusability="afterDescendants"
                android:nextFocusDown="@+id/etNewPlaylistName" />

            <!-- Form thêm nguồn M3U mới -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1930"
                android:padding="10dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thêm nguồn M3U mới:"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNewPlaylistName"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:background="#0F0E1D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:hint="Tên danh sách (Ví dụ: FPT IPTV, Thể Thao...)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionNext"
                    android:nextFocusUp="@+id/rvPlaylists"
                    android:nextFocusDown="@+id/etNewPlaylistUrl"
                    android:nextFocusRight="@+id/etUdpxyServer"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <EditText
                    android:id="@+id/etNewPlaylistUrl"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:background="#0F0E1D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:hint="Đường link URL hoặc đường dẫn file local"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="12sp"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:nextFocusUp="@+id/etNewPlaylistName"
                    android:nextFocusDown="@+id/btnBrowseLocalFile"
                    android:nextFocusRight="@+id/rbPlayerVlc"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBrowseLocalFile"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="📂 Chọn File Local/USB"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/selector_button_tv"
                        android:nextFocusUp="@+id/etNewPlaylistUrl"
                        android:nextFocusRight="@+id/btnAddPlaylist"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <Button
                        android:id="@+id/btnAddPlaylist"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="+ Thêm Danh Sách"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/selector_button_tv"
                        android:nextFocusUp="@+id/etNewPlaylistUrl"
                        android:nextFocusLeft="@+id/btnBrowseLocalFile"
                        android:nextFocusRight="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- CỘT PHẢI: CÀI ĐẶT TRÌNH PHÁT (KHỬ XÉ HÌNH) & KHỞI ĐỘNG (Hỗ trợ cuộn ScrollView trên TV) -->
        <ScrollView
            android:id="@+id/scrollViewSettingsRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_fpt_glass_panel"
            android:padding="14dp"
            android:layout_marginStart="8dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- PHẦN A: MÁY CHỦ UDPXY SERVER (Đặt ở vị trí 2 đầu trang bên phải để bàn phím ảo không che) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Máy Chủ udpxy (Chuyển luồng UDP/RTP):"
                android:textColor="@color/fpt_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutUdpxySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1930"
                android:padding="8dp"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etUdpxyServer"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#0F0E1D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:hint="IP:Port (Ví dụ: 192.168.1.1:4022 hoặc 10.0.0.222:4022)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="12sp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:nextFocusDown="@+id/rbPlayerVlc"
                    android:nextFocusLeft="@+id/etNewPlaylistName"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tự động chuyển tiếp các kênh UDP/RTP qua server udpxy mà không cần can thiệp vào link."
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- PHẦN B: BỘ GIẢI MÃ VIDEO (KHỬ RĂNG CƯA 1080i) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="3. Bộ Giải Mã Video &amp; Khử Xé Hình (Deinterlace):"
                android:textColor="@color/fpt_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgPlayerEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1B1930"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbPlayerVlc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LibVLC (Phần cứng MediaCodec - Mượt mà 60fps, Không xanh màn)"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/etUdpxyServer"
                    android:nextFocusDown="@+id/rbPlayerExo"
                    android:nextFocusLeft="@+id/etNewPlaylistName"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <RadioButton
                    android:id="@+id/rbPlayerExo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ExoPlayer (Google MediaCodec - Nhẹ máy chuẩn Android TV)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:nextFocusUp="@+id/rbPlayerVlc"
                    android:nextFocusDown="@+id/rbDeinterlaceYadif"
                    android:nextFocusLeft="@+id/etNewPlaylistUrl"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thuật toán khử răng cưa / xé hình 1080i (VLC):"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDeinterlaceMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1B1930"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbDeinterlaceYadif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yadif (Khuyên dùng - Nét như PC, không mờ, không bóng ma)"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/rbPlayerExo"
                    android:nextFocusDown="@+id/rbDeinterlaceLinear"
                    android:nextFocusLeft="@+id/btnAddPlaylist"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <RadioButton
                    android:id="@+id/rbDeinterlaceLinear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Linear (Nội suy mượt mà, triệt tiêu xé hình, siêu nhẹ)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:nextFocusUp="@+id/rbDeinterlaceYadif"
                    android:nextFocusDown="@+id/rbDeinterlaceBlend"
                    android:nextFocusLeft="@+id/btnAddPlaylist"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <RadioButton
                    android:id="@+id/rbDeinterlaceBlend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Blend (Gộp 2 trường quét - Mức độ cơ bản)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:nextFocusUp="@+id/rbDeinterlaceLinear"
                    android:nextFocusDown="@+id/rbDeinterlaceOff"
                    android:nextFocusLeft="@+id/btnAddPlaylist"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <RadioButton
                    android:id="@+id/rbDeinterlaceOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tắt Deinterlace (Giữ nguyên luồng gốc)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:nextFocusUp="@+id/rbDeinterlaceBlend"
                    android:nextFocusDown="@+id/etHttpUserAgent"
                    android:nextFocusLeft="@+id/btnAddPlaylist"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </RadioGroup>

            <!-- PHẦN C: HTTP USER AGENT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="4. HTTP User Agent (Danh tính phát IPTV):"
                android:textColor="@color/fpt_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1930"
                android:padding="8dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etHttpUserAgent"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="#0F0E1D"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:hint="Mozilla/5.0... (IPTV User Agent)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="11sp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:nextFocusUp="@+id/rbDeinterlaceOff"
                    android:nextFocusDown="@+id/btnResetUserAgent"
                    android:nextFocusLeft="@+id/btnAddPlaylist"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnResetUserAgent"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/selector_button_tv"
                        android:text="Mặc định"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:nextFocusUp="@+id/etHttpUserAgent"
                        android:nextFocusDown="@+id/rbFirstChannel"
                        android:nextFocusLeft="@+id/btnAddPlaylist"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="center_vertical"
                        android:text="Mặc định phổ thông (Android / Chrome)"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- PHẦN D: CÀI ĐẶT KHỞI ĐỘNG CÙNG TV -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="5. Cài Đặt Khởi Động &amp; Mở Kênh Tự Động:"
                android:textColor="@color/fpt_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1930"
                android:padding="8dp"
                android:layout_marginTop="6dp">

                <!-- Lựa chọn kênh mở khi khởi động -->
                <RadioGroup
                    android:id="@+id/rgStartupMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbFirstChannel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mở kênh đầu tiên của danh sách (Mặc định)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/btnResetUserAgent"
                        android:nextFocusDown="@+id/rbLastWatched"
                        android:nextFocusLeft="@+id/btnAddPlaylist"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <RadioButton
                        android:id="@+id/rbLastWatched"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Vào lại kênh vừa xem gần nhất"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/rbFirstChannel"
                        android:nextFocusDown="@+id/rbFixedChannel"
                        android:nextFocusLeft="@+id/btnAddPlaylist"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <RadioButton
                        android:id="@+id/rbFixedChannel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Luôn mở một kênh cố định:"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:nextFocusUp="@+id/rbLastWatched"
                        android:nextFocusDown="@+id/btnBackupConfig"
                        android:nextFocusLeft="@+id/btnAddPlaylist"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvCurrentFixedChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="2dp"
                    android:text="Chưa thiết lập (Bấm giữ OK trên kênh bất kỳ để đặt làm mặc định)"
                    android:textColor="@color/fpt_orange"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- PHẦN D: SAO LƯU & KHÔI PHỤC CẤU HÌNH -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="5. Sao Lưu &amp; Khôi Phục Cấu Hình:"
                android:textColor="@color/fpt_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1930"
                android:padding="8dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBackupConfig"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="💾  SAO LƯU"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/selector_button_tv"
                        android:nextFocusUp="@+id/rbFixedChannel"
                        android:nextFocusRight="@+id/btnRestoreConfig"
                        android:nextFocusDown="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <Button
                        android:id="@+id/btnRestoreConfig"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="📥  KHÔI PHỤC"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/selector_button_tv"
                        android:nextFocusUp="@+id/rbFixedChannel"
                        android:nextFocusLeft="@+id/btnBackupConfig"
                        android:nextFocusDown="@+id/btnCloseSettings"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBackupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Lưu toàn bộ danh sách M3U, yêu thích, udpxy và thiết lập vào file tvplay_backup.json."
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Nút Đóng & Áp Dụng -->
            <Button
                android:id="@+id/btnCloseSettings"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="✓  ĐÓNG &amp; ÁP DỤNG"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/selector_button_tv"
                android:nextFocusUp="@+id/btnBackupConfig"
                android:nextFocusLeft="@+id/btnAddPlaylist"
                android:focusable="true"
                android:focusableInTouchMode="true" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>
