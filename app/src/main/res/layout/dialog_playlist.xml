<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_item_normal"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cài đặt danh sách kênh IPTV (M3U)"
        android:textColor="@color/accent"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhập đường dẫn URL của danh sách M3U hoặc M3U8:"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etPlaylistUrl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#0F172A"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:hint="@string/playlist_url_hint"
        android:inputType="textUri"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textSize="14sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Các link mẫu để test nhanh -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh sách mẫu miễn phí:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSampleVn"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Kênh Việt Nam (IPTV-org)"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:background="@drawable/selector_button_tv"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/btnSampleGlobal"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Kênh Tin Tức Quốc Tế"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:background="@drawable/selector_button_tv"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/selector_button_tv"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:text="@string/save_and_load"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/selector_button_tv"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

</LinearLayout>
