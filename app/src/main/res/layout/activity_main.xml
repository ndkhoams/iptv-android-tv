<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fpt_bg_dark"
    android:keepScreenOn="true">

    <!-- 1. Trình phát VLC khử xé hình 1080i (Mặc định) -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- 1b. Trình phát ExoPlayer (Dự phòng) -->
    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit"
        android:visibility="gone" />

    <!-- 2. Loading / Buffering Spinner Cam FPT -->
    <LinearLayout
        android:id="@+id/layoutBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_fpt_glass_panel"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/fpt_orange" />

        <TextView
            android:id="@+id/tvBufferingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/stream_buffering"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Error Alert Banner -->
    <LinearLayout
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_fpt_glass_panel"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LỖI PHÁT KÊNH"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bấm ▲ ▼ để đổi kênh khác"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 4. Quick Info Banner Chuẩn G2 khi chuyển kênh (Hiện tên chương trình EPG đang chạy rồi tự ẩn) -->
    <LinearLayout
        android:id="@+id/quickChannelInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_fpt_quick_banner"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvQuickNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fpt_orange"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="01" />

        <ImageView
            android:id="@+id/ivQuickLogo"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv_placeholder" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvQuickName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="VTV1 HD" />

            <!-- Tên chương trình EPG đang phát thời gian thực -->
            <TextView
                android:id="@+id/tvQuickProgramTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/fpt_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="● Đang phát: Bản tin Thời sự" />

            <!-- Dòng 3: Độ phân giải luồng, FPS, Bitrate -->
            <TextView
                android:id="@+id/tvQuickResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1920x1080 @ 50fps • 8.0 Mbps • FHD 1080"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Dòng 4: Thông tin Audio (Codec, Kênh âm thanh Stereo/5.1, Tần số lấy mẫu) -->
            <TextView
                android:id="@+id/tvQuickAudioBitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Âm thanh: AAC Stereo 2.0 (48kHz)"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. GIAO DIỆN CHÍNH FPT PLAY BOX G2 3 CỘT (Tối ưu 1280x720) -->
    <LinearLayout
        android:id="@+id/channelGuideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fpt_overlay_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Header Bar: FPT Play Logo & Slogan + Clock + IP Remote -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- TV Play Brand Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV"
                    android:textColor="@color/fpt_orange"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="Play"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_fpt_badge"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="IPTV"
                    android:textColor="@color/fpt_orange"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Huy hiệu Nguồn Playlist -->
            <TextView
                android:id="@+id/tvActivePlaylistBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_fpt_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:text="Danh sách: FPT" />

            <!-- Địa chỉ Web Server điều khiển từ Điện thoại -->
            <TextView
                android:id="@+id/tvWebRemoteBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_fpt_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="📱 Web Remote: http://192.168.1.xxx:8080" />

            <!-- Khoảng trống đẩy nút về bên phải -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Đồng hồ thời gian thực TV -->
            <TextView
                android:id="@+id/tvDigitalClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="12:00" />
        </LinearLayout>

        <!-- KHU VỰC THÂN GIAO DIỆN 3 CỘT + SIDEBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- THANH SIDEBAR ĐIỀU HƯỚNG BÊN TRÁI (Thu gọn 42dp) -->
            <LinearLayout
                android:id="@+id/layoutSidebar"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- 1. Kênh Yêu Thích -->
                <ImageButton
                    android:id="@+id/navFavorites"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_star_filled"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/navFavorites"
                    android:nextFocusRight="@+id/rvCategories"
                    android:nextFocusDown="@+id/navPlaylists"
                    android:contentDescription="Kênh yêu thích" />

                <!-- 2. Chọn Danh Sách Phát Nhanh -->
                <ImageButton
                    android:id="@+id/navPlaylists"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_nav_playlist"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/navFavorites"
                    android:nextFocusRight="@+id/rvCategories"
                    android:nextFocusDown="@+id/navSidebarSettings"
                    android:contentDescription="Chọn danh sách phát nhanh" />

                <!-- 3. Cài đặt hệ thống -->
                <ImageButton
                    android:id="@+id/navSidebarSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_settings"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/navPlaylists"
                    android:nextFocusDown="@+id/navSidebarSettings"
                    android:nextFocusRight="@+id/rvCategories"
                    android:contentDescription="Cài đặt" />
            </LinearLayout>

            <!-- CỘT 1: DANH MỤC NHÓM KÊNH (Thu gọn 150dp) -->
            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:background="@drawable/bg_fpt_glass_panel"
                android:padding="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DANH MỤC"
                    android:textColor="@color/fpt_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusLeft="@+id/navFavorites"
                    android:nextFocusRight="@+id/rvChannels"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- CỘT 2: DANH SÁCH KÊNH (Dành không gian rộng rãi để không mất chữ tên kênh trên 1280x720) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_fpt_glass_panel"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tvCategoryHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/all_channels"
                        android:textColor="@color/fpt_orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChannelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 kênh"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusLeft="@+id/rvCategories"
                    android:nextFocusRight="@+id/rvSpotlightEpg"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- CỘT 3: SPOTLIGHT / EPG TIMELINE LỊCH PHÁT SÓNG (270dp) -->
            <LinearLayout
                android:id="@+id/layoutSpotlightCol"
                android:layout_width="270dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/bg_fpt_glass_panel"
                android:padding="12dp">

                <!-- Logo Kênh nổi bật -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#1B1930">

                    <ImageView
                        android:id="@+id/ivSpotlightLogo"
                        android:layout_width="100dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tv_placeholder" />

                    <!-- Live Indicator -->
                    <TextView
                        android:id="@+id/tvSpotlightLiveTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_fpt_badge_live"
                        android:text="TRỰC TIẾP"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Tên kênh & Số hiệu -->
                <TextView
                    android:id="@+id/tvSpotlightName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="VTV1 HD"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Nhãn Tags: Độ phân giải + Nguồn CDN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSpotlightResolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_fpt_badge"
                        android:text="FHD 1080i"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpotlightCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_fpt_badge"
                        android:text="VTV"
                        android:textColor="@color/fpt_orange"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpotlightStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:text="● Đang phát"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- KHU VỰC EPG TIMELINE LỊCH PHÁT SÓNG THỜI GIAN THỰC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:background="#151329"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#151329"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LỊCH PHÁT SÓNG (EPG)"
                            android:textColor="@color/fpt_orange"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEpgSourceTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="lichphatsong.io.vn"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Danh sách timeline EPG (Được giới hạn khung nhìn chuẩn xác, không tràn đè chữ) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSpotlightEpg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="4dp"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:overScrollMode="never"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:descendantFocusability="afterDescendants"
                        android:nextFocusLeft="@+id/rvChannels" />

                    <!-- Thông báo khi chưa có EPG -->
                    <TextView
                        android:id="@+id/tvEpgEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Đang tải lịch phát sóng..."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvSpotlightStreamInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#151329"
                        android:paddingTop="2dp"
                        android:text="Giao thức: UDP / udpxy"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:singleLine="true"
                        android:ellipsize="middle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Thanh hướng dẫn sử dụng Remote điều khiển -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="▲▼ Đổi kênh  •  ◄► Chuyển danh mục  •  OK: Phát  •  Giữ OK: Menu tác vụ  •  Menu: Cài đặt  •  📱 Web: port 8080"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
