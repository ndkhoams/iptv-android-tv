<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:keepScreenOn="true">

    <!-- Video Player (Full Màn Hình) -->
    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- Loading / Buffering Spinner -->
    <LinearLayout
        android:id="@+id/layoutBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#A6000000"
        android:padding="20dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/tvBufferingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stream_buffering"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Error message banner -->
    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#D9B91C1C"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:text="@string/stream_error"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Quick Info Banner khi chuyển kênh (hiện 3s rồi ẩn) -->
    <LinearLayout
        android:id="@+id/quickChannelInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_item_normal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvQuickNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="01" />

        <TextView
            android:id="@+id/tvQuickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="VTV1 HD" />
    </LinearLayout>

    <!-- GIAO DIỆN BẢNG KÊNH & MENU CHÍNH (OSD Overlay) -->
    <LinearLayout
        android:id="@+id/channelGuideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/tv_overlay_bg"
        android:padding="24dp"
        android:visibility="visible">

        <!-- Top Bar: Tiêu đề + Nguồn Playlist + Nút thao tác -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActivePlaylistBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="#1E293B"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="Danh sách: Mặc định" />

            <TextView
                android:id="@+id/tvCurrentPlayingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="" />

            <!-- Nút Tải lại -->
            <Button
                android:id="@+id/btnReload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:paddingHorizontal="16dp"
                android:text="@string/reload"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/selector_button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Nút Cài đặt Playlist -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="16dp"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/selector_button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>

        <!-- Thân: Cột Nhóm bên trái + Cột Kênh bên phải -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Danh sách Nhóm kênh -->
            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_item_normal"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DANH MỤC"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- Danh sách Kênh -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_item_normal"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvCategoryHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/all_channels"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChannelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 kênh"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clipToPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Thanh hướng dẫn sử dụng Remote điều khiển -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Nhấn OK: Xem kênh • Giữ OK: Yêu Thích ★ / Đặt Mặc Định • Menu: Cài Đặt"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
