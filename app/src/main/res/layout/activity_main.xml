<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fpt_bg_dark"
    android:keepScreenOn="true">

    <!-- 1. Video Player Fullscreen -->
    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- 2. Loading / Buffering Spinner Cam FPT -->
    <LinearLayout
        android:id="@+id/layoutBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_fpt_glass_panel"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/fpt_orange" />

        <TextView
            android:id="@+id/tvBufferingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/stream_buffering"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Error Alert Banner -->
    <LinearLayout
        android:id="@+id/tvErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_fpt_glass_panel"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LỖI PHÁT KÊNH"
            android:textColor="#EF4444"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bấm ▲ ▼ để đổi kênh khác"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 4. Quick Info Banner Chuẩn G2 khi chuyển kênh (Tự ẩn sau 3.5s) -->
    <LinearLayout
        android:id="@+id/quickChannelInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_fpt_quick_banner"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvQuickNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fpt_orange"
            android:textSize="26sp"
            android:textStyle="bold"
            android:text="01" />

        <ImageView
            android:id="@+id/ivQuickLogo"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginStart="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv_placeholder" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvQuickName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="VTV1 HD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FHD 1080i • FPT Play Live"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. GIAO DIỆN CHÍNH FPT PLAY BOX G2 3 CỘT (OSD Overlay) -->
    <LinearLayout
        android:id="@+id/channelGuideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fpt_overlay_bg"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:visibility="visible">

        <!-- Header Bar: FPT Play Logo & Slogan + Clock + IP Remote + Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- FPT Play Brand Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="fpt"
                    android:textColor="@color/fpt_orange"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="play"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_fpt_badge"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="IPTV G2"
                    android:textColor="@color/fpt_orange"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Huy hiệu Nguồn Playlist -->
            <TextView
                android:id="@+id/tvActivePlaylistBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_fpt_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="Danh sách: Mặc định" />

            <!-- Địa chỉ Web Server điều khiển từ Điện thoại -->
            <TextView
                android:id="@+id/tvWebRemoteBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_fpt_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="📱 Web Remote: http://192.168.1.xxx:8080" />

            <!-- Khoảng trống đẩy nút về bên phải -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Đồng hồ thời gian thực TV -->
            <TextView
                android:id="@+id/tvDigitalClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="12:00" />

            <!-- Nút Tải lại Playlist -->
            <Button
                android:id="@+id/btnReload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/reload"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/selector_button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Nút Cài đặt Playlist -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@drawable/selector_button_tv"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>

        <!-- KHU VỰC THÂN GIAO DIỆN 3 CỘT + SIDEBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- THANH SIDEBAR ĐIỀU HƯỚNG BÊN TRÁI -->
            <LinearLayout
                android:id="@+id/layoutSidebar"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- 1. Live TV Tất cả -->
                <ImageButton
                    android:id="@+id/navLiveTv"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_nav_tv"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusRight="@+id/rvCategories"
                    android:nextFocusDown="@+id/navFavorites"
                    android:contentDescription="Tất cả kênh" />

                <!-- 2. Kênh Yêu Thích -->
                <ImageButton
                    android:id="@+id/navFavorites"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_star_filled"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/navLiveTv"
                    android:nextFocusRight="@+id/rvCategories"
                    android:nextFocusDown="@+id/navPlaylists"
                    android:contentDescription="Kênh yêu thích" />

                <!-- 3. Quản lý Playlist -->
                <ImageButton
                    android:id="@+id/navPlaylists"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_nav_playlist"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/navFavorites"
                    android:nextFocusRight="@+id/rvCategories"
                    android:nextFocusDown="@+id/navPhoneRemote"
                    android:contentDescription="Quản lý Playlist" />

                <!-- 4. Web Remote QR / IP -->
                <ImageButton
                    android:id="@+id/navPhoneRemote"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_nav_phone"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/navPlaylists"
                    android:nextFocusRight="@+id/rvCategories"
                    android:nextFocusDown="@+id/navSidebarSettings"
                    android:contentDescription="Điều khiển từ điện thoại" />

                <!-- 5. Cài đặt hệ thống -->
                <ImageButton
                    android:id="@+id/navSidebarSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/selector_fpt_sidebar"
                    android:src="@drawable/ic_settings"
                    android:scaleType="centerInside"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/navPhoneRemote"
                    android:nextFocusRight="@+id/rvCategories"
                    android:contentDescription="Cài đặt" />
            </LinearLayout>

            <!-- CỘT 1: DANH MỤC NHÓM KÊNH -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/bg_fpt_glass_panel"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DANH MỤC"
                    android:textColor="@color/fpt_orange"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@+id/navLiveTv"
                    android:nextFocusRight="@+id/rvChannels"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- CỘT 2: DANH SÁCH KÊNH (FPT G2 Channel Guide) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_fpt_glass_panel"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tvCategoryHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/all_channels"
                        android:textColor="@color/fpt_orange"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChannelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 kênh"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChannels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@+id/rvCategories"
                    android:nextFocusRight="@+id/btnSpotlightPlay"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- CỘT 3: SPOTLIGHT / LIVE PREVIEW PANE -->
            <LinearLayout
                android:id="@+id/layoutSpotlightCol"
                android:layout_width="320dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_fpt_glass_panel"
                android:padding="16dp">

                <!-- Logo Kênh nổi bật -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:background="#1B1930">

                    <ImageView
                        android:id="@+id/ivSpotlightLogo"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tv_placeholder" />

                    <!-- Live Indicator -->
                    <TextView
                        android:id="@+id/tvSpotlightLiveTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_fpt_badge_live"
                        android:text="TRỰC TIẾP"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Tên kênh & Số hiệu -->
                <TextView
                    android:id="@+id/tvSpotlightName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="VTV1 HD"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Nhãn Tags: Độ phân giải + Nguồn CDN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSpotlightResolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_fpt_badge"
                        android:text="FHD 1080i"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpotlightCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_fpt_badge"
                        android:text="VTV"
                        android:textColor="@color/fpt_orange"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpotlightStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:text="● Đang phát"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Lịch phát sóng / Thông tin chương trình -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="#151329"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LỊCH PHÁT SÓNG"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpotlightEpgNow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="● Đang phát: Chương trình truyền hình trực tiếp"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvSpotlightEpgNext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="○ Kế tiếp: Phim truyện đặc sắc / Thể thao 24/7"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvSpotlightStreamInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Giao thức: UDP Multicast / HLS"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:singleLine="true"
                        android:ellipsize="middle" />
                </LinearLayout>

                <!-- Các nút thao tác Spotlight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <!-- Nút Xem kênh ngay -->
                    <Button
                        android:id="@+id/btnSpotlightPlay"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="▶  PHÁT KÊNH NÀY"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/selector_button_tv"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusLeft="@+id/rvChannels"
                        android:nextFocusDown="@+id/btnSpotlightFav" />

                    <!-- Hàng nút Yêu thích & Mặc định -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSpotlightFav"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="★ YÊU THÍCH"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:background="@drawable/selector_button_tv"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusLeft="@+id/rvChannels"
                            android:nextFocusUp="@+id/btnSpotlightPlay" />

                        <Button
                            android:id="@+id/btnSpotlightDefault"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="⚡ MẶC ĐỊNH"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:background="@drawable/selector_button_tv"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusLeft="@+id/btnSpotlightFav"
                            android:nextFocusUp="@+id/btnSpotlightPlay" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Thanh hướng dẫn sử dụng Remote điều khiển -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="▲▼ Đổi kênh  •  ◄► Chuyển danh mục  •  OK: Phát  •  Giữ OK: Menu tác vụ  •  Menu: Cài đặt  •  📱 Web: port 8080"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
