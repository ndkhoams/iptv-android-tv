<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/selector_channel_item">

    <!-- Icon đang chọn -->
    <ImageView
        android:id="@+id/ivSelectedCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="Kênh Mẫu Việt Nam" />

        <TextView
            android:id="@+id/tvPlaylistUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="https://..." />
    </LinearLayout>

    <!-- Nút xóa playlist -->
    <ImageButton
        android:id="@+id/btnDeletePlaylist"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/selector_button_tv"
        android:src="@drawable/ic_delete"
        android:scaleType="centerInside"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
