<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <!-- Khu vực bấm để chọn Playlist (D-pad Focusable) -->
    <LinearLayout
        android:id="@+id/layoutPlaylistSelect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:nextFocusRight="@+id/btnDeletePlaylist"
        android:background="@drawable/selector_channel_item">

        <!-- Icon đang chọn -->
        <ImageView
            android:id="@+id/ivSelectedCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:id="@+id/tvPlaylistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/selector_fpt_channel_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Kênh Mẫu Việt Nam" />

            <TextView
                android:id="@+id/tvPlaylistUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/selector_playlist_subtext"
                android:duplicateParentState="true"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="https://..." />
        </LinearLayout>
    </LinearLayout>

    <!-- Nút xóa playlist độc lập (D-pad Sang Phải để chọn) -->
    <ImageButton
        android:id="@+id/btnDeletePlaylist"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/selector_btn_delete_tv"
        android:src="@drawable/ic_delete"
        android:tint="@color/selector_delete_icon_tint"
        android:scaleType="centerInside"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:nextFocusLeft="@+id/layoutPlaylistSelect"
        android:contentDescription="Xóa danh sách" />

</LinearLayout>
