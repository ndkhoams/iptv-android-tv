<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_voice_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Mic Circle Icon with Pulsing Effect -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/btn_circle_selector">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivVoiceMic"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            app:tint="@color/btn_mic" />
    </FrameLayout>

    <!-- Audio Waveform Visualizer (Custom View) -->
    <com.samsung.tvremote.VoiceWaveView
        android:id="@+id/voiceWaveView"
        android:layout_width="200dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp" />

    <!-- Voice Recognition Status Title -->
    <TextView
        android:id="@+id/tvVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Đang lắng nghe..."
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Voice Recognition Subtitle / Prompt -->
    <TextView
        android:id="@+id/tvVoiceSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Hãy nói từ khóa bạn muốn xem (VD: VTV1, Ca nhạc, Thời sự...)"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <!-- Action Buttons: Finish Speaking & Cancel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVoiceFinish"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.3"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_remote_selector"
            android:backgroundTint="@color/btn_mic"
            android:text="Kết thúc nói"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVoiceCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_remote_selector"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_white"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
