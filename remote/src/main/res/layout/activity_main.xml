<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Header: Cài đặt (trái) - Tên TV + Status (giữa) - Nguồn đỏ (phải) THẲNG HÀNG 100% VỚI PHÍA DƯỚI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <!-- Cột 1: Nút Cài đặt (thẳng cột 100% với Prev, Back, Mute, VOL) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_settings"
                    android:src="@drawable/ic_gear"
                    app:tint="@color/text_dim" />
            </FrameLayout>

            <!-- Cột 2: Trạng thái TV (thẳng cột 100% với Play/Pause, Home, Mic) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/status_dot_offline" />

                    <TextView
                        android:id="@+id/tvTvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/tv_status_checking"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Cột 3: Nút Nguồn đỏ (thẳng cột 100% với Next, Numpad, Keyboard, CH) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnPower"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_power_selector"
                    android:contentDescription="@string/desc_power"
                    android:src="@drawable/ic_power"
                    app:tint="@color/text_white" />
            </FrameLayout>
        </LinearLayout>

        <!-- Main Remote Body Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_remote_body"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <!-- 1. Hàng Media (3 phím 1 hàng): Prev (|◀), Play/Pause (▶||), Next (▶|) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cột 1: Prev -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnMediaPrev"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="@string/desc_media_prev"
                        android:src="@drawable/ic_media_prev"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <!-- Cột 2: Play/Pause -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnMediaPlayPause"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="@string/desc_media_play_pause"
                        android:src="@drawable/ic_media_play_pause"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <!-- Cột 3: Next -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnMediaNext"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="@string/desc_media_next"
                        android:src="@drawable/ic_media_next"
                        app:tint="@color/text_white" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2. Cụm điều hướng trung tâm (D-Pad tròn lớn): Up, Down, Left, Right & OK -->
            <FrameLayout
                android:layout_width="224dp"
                android:layout_height="224dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_dpad_surface">

                <!-- UP -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnUp"
                    android:layout_width="80dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/btn_rocker_half"
                    android:contentDescription="@string/btn_up"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="@color/text_white" />

                <!-- DOWN -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnDown"
                    android:layout_width="80dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/btn_rocker_half"
                    android:contentDescription="@string/btn_down"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_white" />

                <!-- LEFT -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnLeft"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_rocker_half"
                    android:contentDescription="@string/btn_left"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/text_white" />

                <!-- RIGHT -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnRight"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_rocker_half"
                    android:contentDescription="@string/btn_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_white" />

                <!-- CENTER OK -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOk"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_dpad_center"
                    android:text="@string/btn_ok"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 3. Hàng chức năng 1 (3 phím 1 hàng): Back (Cột 1) - Home (Cột 2) - Numpad (Cột 3) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cột 1: Back (thẳng cột với Prev) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="@string/btn_back"
                        android:src="@drawable/ic_back"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <!-- Cột 2: Home (thẳng cột với Play/Pause) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnHome"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="@string/btn_home"
                        android:src="@drawable/ic_home"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <!-- Cột 3: Numpad (thẳng cột với Next) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnNumpad"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="@string/dialog_numpad_title"
                        android:src="@drawable/ic_numpad"
                        app:tint="@color/text_white" />
                </FrameLayout>
            </LinearLayout>

            <!-- 4. Hàng chức năng 2 (3 phím 1 hàng): Mute (Cột 1) - Mic (Cột 2) - Keyboard (Cột 3) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cột 1: Mute (thẳng cột với Back & Prev) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnMute"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="Mute"
                        android:src="@drawable/ic_mute"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <!-- Cột 2: Mic (thẳng cột với Home & Play/Pause) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnMic"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_mic_selector"
                        android:contentDescription="Voice Search"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <!-- Cột 3: Keyboard (thẳng cột với Numpad & Next) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnKeyboard"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_circle_selector"
                        android:contentDescription="@string/dialog_keyboard_title"
                        android:src="@drawable/ic_keyboard"
                        app:tint="@color/text_white" />
                </FrameLayout>
            </LinearLayout>

            <!-- 5. Hàng 3: Cụm phím con nhộng VOL (Cột 1) và CH (Cột 3) THẲNG CỘT 100% VỚI PHÍA TRÊN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cột 1: Con nhộng VOL (+ / -) nằm chính giữa Cột 1, thẳng hàng với Mute, Back, Prev -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_capsule"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnVolUp"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/btn_capsule_top"
                            android:text="@string/btn_plus"
                            android:textColor="@color/text_white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:letterSpacing="0.1"
                            android:text="@string/btn_vol"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnVolDown"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/btn_capsule_bottom"
                            android:text="@string/btn_minus"
                            android:textColor="@color/text_white"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Cột 2: Khoảng đệm ở giữa để giữ đúng lưới 3 cột đối xứng -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- Cột 3: Con nhộng CH (∧ / ∨) nằm chính giữa Cột 3, thẳng hàng với Keyboard, Numpad, Next -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_capsule"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnChUp"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/btn_capsule_top"
                            android:text="@string/btn_chevron_up"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:letterSpacing="0.1"
                            android:text="@string/btn_ch"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnChDown"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/btn_capsule_bottom"
                            android:text="@string/btn_chevron_down"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

            <!-- 6. Bottom Toast / Execution Feedback -->
            <TextView
                android:id="@+id/tvToast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minHeight="22dp"
                android:text="Sẵn sàng"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
