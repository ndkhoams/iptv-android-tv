<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- 1. Header: Cài đặt (trái) - Tên TV + Status (giữa) - Nguồn đỏ (phải) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Nút Cài đặt (bánh răng) -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_settings"
                android:src="@drawable/ic_gear"
                app:tint="@color/text_white" />

            <!-- Chấm trạng thái kết nối + tên thiết bị TV ở giữa -->
            <LinearLayout
                android:id="@+id/layoutTvStatus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_dot_offline" />

                <TextView
                    android:id="@+id/tvTvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tv_status_checking"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="▾"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Nút Nguồn đỏ (outline red vector icon) -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPower"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_power"
                android:src="@drawable/ic_power" />
        </LinearLayout>

        <!-- 2. Hàng phím Media (5 nút tròn): Prev (|◀), Rewind (◀◀), Play/Pause (▶||), FF (▶▶), Next (▶|) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMediaPrev"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_circle_selector"
                    android:contentDescription="@string/desc_media_prev"
                    android:src="@drawable/ic_media_prev"
                    app:tint="@color/text_white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMediaRewind"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_circle_selector"
                    android:contentDescription="@string/desc_media_rewind"
                    android:src="@drawable/ic_media_rewind"
                    app:tint="@color/text_white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMediaPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_circle_selector"
                    android:contentDescription="@string/desc_media_play_pause"
                    android:src="@drawable/ic_media_play_pause"
                    app:tint="@color/text_white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMediaFF"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_circle_selector"
                    android:contentDescription="@string/desc_media_ff"
                    android:src="@drawable/ic_media_ff"
                    app:tint="@color/text_white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMediaNext"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_circle_selector"
                    android:contentDescription="@string/desc_media_next"
                    android:src="@drawable/ic_media_next"
                    app:tint="@color/text_white" />
            </FrameLayout>
        </LinearLayout>

        <!-- 3. Cụm điều hướng trung tâm (D-Pad tròn lớn có viền Gradient) -->
        <FrameLayout
            android:layout_width="244dp"
            android:layout_height="244dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_dpad_surface">

            <!-- LÊN (UP) -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnUp"
                android:layout_width="88dp"
                android:layout_height="62dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_up"
                android:src="@drawable/ic_chevron_up"
                app:tint="@color/text_white" />

            <!-- XUỐNG (DOWN) -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnDown"
                android:layout_width="88dp"
                android:layout_height="62dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_down"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_white" />

            <!-- TRÁI (LEFT) -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnLeft"
                android:layout_width="62dp"
                android:layout_height="88dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_left"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_white" />

            <!-- PHẢI (RIGHT) -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnRight"
                android:layout_width="62dp"
                android:layout_height="88dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_right"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_white" />

            <!-- PHÍM OK TRÒN Ở CHÍNH GIỮA (có viền gradient đồng bộ) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOk"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_dpad_center"
                android:contentDescription="@string/btn_ok" />
        </FrameLayout>

        <!-- 4. Chấm chỉ số trang (Indicator dots dưới D-Pad) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/indicator_dot_active" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/indicator_dot_inactive" />
        </LinearLayout>

        <!-- 5. Khu vực điều khiển bên dưới: VOL con nhộng (trái) - Lưới 6 phím (giữa) - CH con nhộng (phải) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Bên trái: Cụm phím âm lượng dạng con nhộng dọc (VOL + / -) -->
            <LinearLayout
                android:layout_width="54dp"
                android:layout_height="146dp"
                android:background="@drawable/bg_capsule"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVolUp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_capsule_top"
                    android:text="@string/btn_plus"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="@string/btn_vol"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVolDown"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_capsule_bottom"
                    android:text="@string/btn_minus"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ở giữa: Lưới 6 phím tròn (2 hàng x 3 cột) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Hàng trên: Bàn phím gõ chữ (Keyboard) - Phím Home - Phím bàn phím số (Numpad) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btnKeyboard"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/btn_circle_selector"
                            android:contentDescription="@string/dialog_keyboard_title"
                            android:src="@drawable/ic_keyboard"
                            app:tint="@color/text_white" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btnHome"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/btn_circle_selector"
                            android:contentDescription="@string/btn_home"
                            android:src="@drawable/ic_home"
                            app:tint="@color/text_white" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btnNumpad"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/btn_circle_selector"
                            android:contentDescription="@string/dialog_numpad_title"
                            android:src="@drawable/ic_numpad"
                            app:tint="@color/text_white" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Hàng dưới: Tắt tiếng (Mute) - Nút Nói (Micro tìm kiếm giọng nói) - Phím Quay lại (Back) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btnMute"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/btn_circle_selector"
                            android:contentDescription="Mute"
                            android:src="@drawable/ic_mute"
                            app:tint="@color/text_white" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btnMic"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/btn_circle_selector"
                            android:contentDescription="Voice Search"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/text_white" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btnBack"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:background="@drawable/btn_circle_selector"
                            android:contentDescription="@string/btn_back"
                            android:src="@drawable/ic_back"
                            app:tint="@color/text_white" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Bên phải: Cụm phím chuyển kênh dạng con nhộng dọc (CH ∧ / ∨) -->
            <LinearLayout
                android:layout_width="54dp"
                android:layout_height="146dp"
                android:background="@drawable/bg_capsule"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnChUp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_capsule_top"
                    android:contentDescription="Channel Up"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="@color/text_white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="@string/btn_ch"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnChDown"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_capsule_bottom"
                    android:contentDescription="Channel Down"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_white" />
            </LinearLayout>
        </LinearLayout>

        <!-- 6. Phản hồi thực thi / Trạng thái -->
        <TextView
            android:id="@+id/tvToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="20dp"
            android:text="Sẵn sàng"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
