<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient outer ring: Violet/Purple to Cyan/Blue -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#8A2BE2"
                android:centerColor="#6366F1"
                android:endColor="#06B6D4" />
        </shape>
    </item>
    <!-- Dark circular surface inset by 2dp to reveal gradient ring -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#1F1F23" />
        </shape>
    </item>
</layer-list>
